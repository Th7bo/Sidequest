{
  "schemaVersion": 1,
  "id": "sidequest",
  "version": "${version}",
  "name": "Sidequest",
  "description": "A client-side companion for a small SkyBlock group. Rare-drop cinematics, shared waypoints and pings, ready checks, playtime tracking, cosmetics and a configurable HUD, with an optional self-hosted backend for syncing between friends.",
  "authors": [
    "th7bo"
  ],
  "license": "ARR",
  "icon": "assets/sidequest/icon.png",
  "environment": "client",
  "contact": {},
  "entrypoints": {
    "client": [
      {
        "value": "dev.th7bo.sidequest.Sidequest",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "sidequest.mixins.json"
  ],
  "accessWidener": "sidequest.classtweaker",
  "depends": {
    "minecraft": "${minecraft_range}",
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": ">=${fabric_api}",
    "fabric-language-kotlin": ">=${fabric_language_kotlin}"
  },
  "suggests": {
    "hypixel-modapi": "*",
    "mcef-modern": "*"
  }
}
